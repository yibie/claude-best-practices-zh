    },
    {
      "en": "agent harness design",
      "zh": "智能体框架设计",
      "def_zh": "决定脚手架中保留什么、随模型变强可移除什么的实践。",
      "kind": "technique"
    },
    {
      "en": "context engineering",
      "zh": "上下文工程",
      "def_zh": "管理模型上下文窗口内容以提升效果与效率的方法。",
      "kind": "technique"
    },
    {
      "en": "programmatic tool calling",
      "zh": "程序化工具调用",
