{
  "summary_zh": "按任务、成本与努力等级选择Claude模型，并组合使用子代理与顾问。",
  "concepts": [
    {
      "en": "effort level",
      "zh": "努力等级",
      "def_zh": "控制模型思考深度与工具调用量的可调参数，影响成本与延迟。",
      "kind": "technique"
    },
    {
      "en": "subagent",
      "zh": "子代理",
      "def_zh": "在独立上下文窗口中运行、向主代理返回摘要的辅助代理。",
      "kind": "technique"
    },
    {
      "en": "prompt caching",
      "zh": "提示缓存",
      "def_zh": "复用已处理上下文以降低重复输入成本的机制，缓存归属生成它的模型。",
      "kind": "technique"
    },
    {
      "en": "context window",
      "zh": "上下文窗口",
      "def_zh": "模型单次可处理的token上限，当前各模型均为100万token。",
      "kind": "metric"
    },
    {
      "en": "cost per finished task",
      "zh": "单任务成本",
