{
  "summary_zh": "Brex 团队使用 Claude Code 提升代码质量与生产力，实现角色融合与数据民主化。",
  "concepts": [
    {
      "en": "Claude Code",
      "zh": "Claude Code",
      "def_zh": "Anthropic 的智能体编程解决方案，可辅助编写、审查和解释代码。",
      "kind": "product"
    },
    {
      "en": "agentic coding",
      "zh": "智能体编程",
      "def_zh": "由 AI 智能体主导代码生成与修改，人类负责引导和审查的编程范式。",
      "kind": "technique"
    },
    {
      "en": "context management",
      "zh": "上下文管理",
      "def_zh": "为 AI 提供结构化领域知识（如 CLAUDE.md 文件）以提升代码理解与生成质量。",
      "kind": "technique"
    },
    {
      "en": "MCP",
      "zh": "MCP",
      "def_zh": "模型上下文协议，用于连接 AI 模型与外部数据源和工具。",
      "kind": "product"
    },
    {
      "en": "text-to-SQL",
      "zh": "文本转 SQL",
