      "kind": "technique"
    },
    {
      "en": "AI data engineering agent",
      "zh": "AI 数据工程智能体",
      "def_zh": "自动完成数据表添加、文件编辑和测试配置等数据工程任务的智能体。",
      "kind": "technique"
    },
    {
      "en": "headless mode",
      "zh": "无头模式",
      "def_zh": "Claude Code 的非交互运行模式，适合自动化脚本和快速构建工具。",
      "kind": "technique"
    },
    {
      "en": "organizational knowledge repository",
      "zh": "组织知识库",
      "def_zh": "将代码库和文档作为可查询的知识源，替代对个人经验的依赖。",
      "kind": "technique"
    },
    {
      "en": "democratizing data access",
      "zh": "数据访问民主化",
      "def_zh": "让非技术角色也能通过自然语言查询和分析数据。",
      "kind": "technique"
    }
