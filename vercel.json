{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "RENDER_DOCS=1 node scripts/build-site.js",
  "outputDirectory": "site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}